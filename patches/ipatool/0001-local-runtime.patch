--- /dev/null
+++ b/internal/sap/assets/lab_progress.go
@@ -0,0 +1,101 @@
+package assets
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// Counts only known regular output files, never credentials or network payloads.
+func componentProgress(directory string) (int, int64) {
+	complete := 0
+	var bytes int64
+	for _, spec := range requiredFiles {
+		info, err := os.Lstat(filepath.Join(directory, spec.name))
+		if err != nil || !info.Mode().IsRegular() {
+			continue
+		}
+		bytes += info.Size()
+		if info.Size() == int64(spec.size) {
+			complete++
+		}
+	}
+	return complete, bytes
+}
+
+func progressLine(complete int, bytes int64, elapsed, unchanged time.Duration) string {
+	total := len(requiredFiles)
+	bar := strings.Repeat("#", complete) + strings.Repeat("-", total-complete)
+	line := fmt.Sprintf("Component output [%s] %d/%d | Written %.1f MiB | Elapsed %s", bar, complete, total, float64(bytes)/(1024*1024), elapsed.Round(time.Second))
+	if unchanged >= 30*time.Second {
+		line += fmt.Sprintf(" | No file changes for %s (download or processing may still be active)", unchanged.Round(time.Second))
+	}
+	return line + "; this counts output files, not download percentage"
+}
+
+// Finishes before authentication prompts resume; never captures terminal input.
+func startComponentProgress(directory string, writer io.Writer, interval time.Duration) func(bool) {
+	stop := make(chan bool, 1)
+	done := make(chan struct{})
+	started := time.Now()
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(interval)
+		defer ticker.Stop()
+		lastCount := -1
+		var lastBytes int64 = -1
+		changed := started
+		// On a terminal, update one line in place; when captured to a file, one line per tick.
+		inplace := false
+		if file, ok := writer.(*os.File); ok {
+			if info, err := file.Stat(); err == nil && info.Mode()&os.ModeCharDevice != 0 {
+				inplace = true
+			}
+		}
+		emit := func() {
+			count, size := componentProgress(directory)
+			now := time.Now()
+			if count != lastCount || size != lastBytes {
+				changed = now
+				lastCount = count
+				lastBytes = size
+			}
+			line := progressLine(count, size, now.Sub(started), now.Sub(changed))
+			if inplace {
+				// Carriage return plus clear-to-end-of-line so a shorter line leaves no tail.
+				fmt.Fprint(writer, "\r"+line+"\x1b[K")
+			} else {
+				fmt.Fprintln(writer, line)
+			}
+		}
+		emit()
+		for {
+			select {
+			case success := <-stop:
+				if success {
+					// Every component is present and hash-verified; show the bar complete.
+					_, size := componentProgress(directory)
+					final := progressLine(len(requiredFiles), size, time.Since(started), 0)
+					if inplace {
+						fmt.Fprint(writer, "\r"+final+"\x1b[K\n")
+					} else {
+						fmt.Fprintln(writer, final)
+					}
+					fmt.Fprintln(writer, "Authentication components are ready and hash-verified; login follows. Watch for the verification-code prompt.")
+				} else {
+					if inplace {
+						fmt.Fprintln(writer)
+					}
+					fmt.Fprintln(writer, "Component preparation ended without completing; see the following error.")
+				}
+				return
+			case <-ticker.C:
+				emit()
+			}
+		}
+	}()
+	return func(success bool) { stop <- success; <-done }
+}
